---
export type ConstellationItem = {
  label: string;
};

type Props = {
  coreLabel?: string;
  items: ConstellationItem[];
  ariaLabel?: string;
};

const { coreLabel = 'Core', items, ariaLabel = 'Synora constellation' } = Astro.props;
const orbitItems = items.slice(0, 4);
---

<div class="constellation" aria-label={ariaLabel}>
  <div class="constellation-orbit" aria-hidden="true">
    <div class="constellation-ring">
      {orbitItems.map((item, index) => (
        <div class="constellation-node" style={`--i:${index}`}>
          <div class="constellation-counter">
            <div class="constellation-chip">{item.label}</div>
          </div>
        </div>
      ))}
    </div>
    <div class="constellation-core">
      <span>{coreLabel}</span>
    </div>
  </div>

  <div class="constellation-grid" role="list">
    {orbitItems.map((item) => (
      <div class="pill" role="listitem">{item.label}</div>
    ))}
  </div>
</div>
