---
export const LINKS_ICON_NAMES = ['arrow-left', 'book', 'globe', 'instagram', 'linkedin', 'mail'] as const;
export type LinksIconName = (typeof LINKS_ICON_NAMES)[number];

type Props = {
  name: LinksIconName;
  title?: string;
};

const { name, title } = Astro.props;
const ariaHidden = title ? undefined : 'true';
const ariaLabel = title ? title : undefined;
---

{name === 'globe' ? (
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden={ariaHidden} aria-label={ariaLabel}>
    <path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z" />
    <path d="M3 12h18" />
    <path d="M12 3c2.5 2.8 4 6 4 9s-1.5 6.2-4 9c-2.5-2.8-4-6-4-9s1.5-6.2 4-9Z" />
  </svg>
) : null}

{name === 'book' ? (
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden={ariaHidden} aria-label={ariaLabel}>
    <path d="M5 4h10a3 3 0 0 1 3 3v13H8a3 3 0 0 0-3 3V4Z" />
    <path d="M19 20H9a3 3 0 0 0-3 3" />
  </svg>
) : null}

{name === 'linkedin' ? (
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden={ariaHidden} aria-label={ariaLabel}>
    <path d="M5 8v12" />
    <path d="M5 4.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Z" />
    <path d="M9 20V12a4 4 0 0 1 8 0v8" />
    <path d="M9 12v8" />
    <path d="M17 20v-8" />
  </svg>
) : null}

{name === 'instagram' ? (
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden={ariaHidden} aria-label={ariaLabel}>
    <rect x="6" y="6" width="12" height="12" rx="3" />
    <path d="M10.5 12a1.5 1.5 0 1 0 3 0 1.5 1.5 0 0 0-3 0Z" />
    <path d="M16.3 7.7h.01" />
  </svg>
) : null}

{name === 'mail' ? (
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden={ariaHidden} aria-label={ariaLabel}>
    <path d="M4 7.5 12 13l8-5.5" />
    <path d="M6 6h12a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2Z" />
  </svg>
) : null}

{name === 'arrow-left' ? (
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden={ariaHidden} aria-label={ariaLabel}>
    <path d="M10 6 4 12l6 6" />
    <path d="M4 12h16" />
  </svg>
) : null}
