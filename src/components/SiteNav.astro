---
import type { Locale, RouteKey } from '../i18n/types';
import { getContent, getRoutePath } from '../i18n';

type Props = {
  locale: Locale;
  routeKey: RouteKey;
  variant?: 'home' | 'internal' | 'quiet';
};

const { locale, routeKey, variant = 'internal' } = Astro.props;
const content = getContent(locale);
const homePath = content.routes.home.path;
const publicationsPath = '/pt/publicacoes/';

const navLinks =
  variant === 'quiet'
    ? []
    : variant === 'home'
      ? [
          { label: content.nav.home, href: homePath },
          { label: content.nav.infrastructure, href: '#infraestrutura' },
          { label: content.nav.solutions, href: '#solucoes' },
          ...(locale === 'pt'
            ? [{ label: content.nav.publications, href: publicationsPath }]
            : []),
          { label: content.nav.about, href: '#sobre' },
          { label: content.nav.contact, href: '#contato' },
        ]
      : [
          { label: content.nav.home, href: homePath },
          { label: content.nav.infrastructure, href: `${homePath}#infraestrutura` },
          { label: content.nav.solutions, href: `${homePath}#solucoes` },
          ...(locale === 'pt'
            ? [{ label: content.nav.publications, href: publicationsPath }]
            : []),
          { label: content.nav.about, href: `${homePath}#sobre` },
          { label: content.nav.contact, href: `${homePath}#contato` },
        ];

const ptHref = getRoutePath('pt', routeKey);
const esHref = getRoutePath('es', routeKey);
const enHref = getRoutePath('en', routeKey);
---

<nav class="nav" aria-label="Primary navigation">
  <div class="nav-inner shell">
    <a class="brand" href={homePath}>
      <span class="brand-mark" aria-hidden="true">
        <img class="brand-logo" src="/brand/synora-mark.svg" alt="" />
      </span>
      <span>Synora</span>
    </a>

    {navLinks.length > 0 && (
      <div class="nav-links" aria-label="Sections">
        {navLinks.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))}
      </div>
    )}

    <div class="nav-actions" aria-label="Actions">
      <div class="lang-switch" aria-label="Language selector">
        <a
          class={locale === 'pt' ? 'is-active' : ''}
          href={ptHref}
          hreflang="pt-BR"
          data-locale="pt"
        >
          {content.nav.langSwitch.pt}
        </a>
        <span aria-hidden="true">|</span>
        <a class={locale === 'es' ? 'is-active' : ''} href={esHref} hreflang="es" data-locale="es">
          {content.nav.langSwitch.es}
        </a>
        <span aria-hidden="true">|</span>
        <a class={locale === 'en' ? 'is-active' : ''} href={enHref} hreflang="en" data-locale="en">
          {content.nav.langSwitch.en}
        </a>
      </div>
      {variant !== 'quiet' && (
        <a class={`button ${routeKey === 'core' ? 'is-active' : ''}`} href={content.routes.core.path}>
          {content.nav.coreCta}
        </a>
      )}
    </div>
  </div>
</nav>

<script is:inline>
  (function () {
    const KEY = 'synora_lang';
    const switchEl = document.querySelector('.lang-switch');
    if (!switchEl) return;
    switchEl.addEventListener('click', function (event) {
      const target = event.target && event.target.closest ? event.target.closest('a[data-locale]') : null;
      if (!target) return;
      try {
        window.localStorage.setItem(KEY, target.getAttribute('data-locale'));
      } catch {}
    });
  })();
</script>
