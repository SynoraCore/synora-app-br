<script is:inline>
  (function () {
    const KEY = 'synora_lang';
    const switchEl = document.querySelector('.lang-switch');
    if (!switchEl) return;
    switchEl.addEventListener('click', function (event) {
      const target = event.target && event.target.closest ? event.target.closest('a[data-locale]') : null;
      if (!target) return;
      try {
        window.localStorage.setItem(KEY, target.getAttribute('data-locale'));
      } catch {}
    });
  })();
</script>

<style>
  .brand-type {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
  }

  .brand-word {
    font-size: 16px;
    line-height: 1;
  }

  .brand-territory {
    display: flex;
    align-items: center;
    gap: 6px;
    user-select: none;
    transform: translateY(-1px);
  }

  .territory-flag {
    width: 15px;
    height: auto;
    display: block;
  }
</style>
