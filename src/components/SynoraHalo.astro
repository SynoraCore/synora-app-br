---
import SynoraHaloSignature from './SynoraHaloSignature.astro';

export type SynoraHaloItem = {
  key: string;
  label: string;
  href: string;
  disabled?: boolean;
  disabledReason?: string;
};

type Props = {
  items: SynoraHaloItem[];
  ariaLabel?: string;
};

const { items, ariaLabel = 'Portal Synora' } = Astro.props;

type Position = { x: number; y: number; startX: number; startY: number; delayMs: number };

const orderedKeysForDelay = [
  'core',
  'mediadora',
  'mediadora-audio',
  'internacional',
  'publicacoes',
  'biblioteca',
] as const;

const mobileAnglesByKey: Record<string, number> = {
  core: 90,
  internacional: 30,
  'mediadora-audio': 330,
  mediadora: 270,
  publicacoes: 210,
  biblioteca: 150,
};

function accentHexForKey(key: string): string {
  switch (key) {
    case 'core':
      return '#304FFE';
    case 'mediadora':
      return '#00BFA5';
    case 'mediadora-audio':
      return '#7C4DFF';
    case 'internacional':
      return '#26A69A';
    // Provisional (nenhum token factual encontrado no repo até aqui)
    case 'biblioteca':
      return '#F6C343';
    case 'publicacoes':
      return '#8E7CFF';
    default:
      return '#4FD1FF';
  }
}

function hexToRgba(hex: string, alpha: number): string {
  const normalized = hex.replace('#', '').trim();
  const full = normalized.length === 3 ? normalized.split('').map((c) => c + c).join('') : normalized;
  const num = Number.parseInt(full, 16);
  const r = (num >> 16) & 255;
  const g = (num >> 8) & 255;
  const b = num & 255;
  return `rgba(${r}, ${g}, ${b}, ${alpha})`;
}

function positionForKey(key: string): Position {
  const angleDeg = mobileAnglesByKey[key] ?? 90;
  const angleRad = (angleDeg * Math.PI) / 180;

  // Geometria (mobile 390×844): v0.7 prioriza respiração (scroll moderado ok).
  // +20–30% de raio para evidenciar corpos independentes orbitando o núcleo.
  const radiusX = 230;
  const radiusY = 372;
  // Motion centrífugo (v0.1): satélites nascem praticamente no núcleo.
  const startRadius = 18;

  const x = Math.cos(angleRad) * radiusX;
  const y = -Math.sin(angleRad) * radiusY;
  const startX = Math.cos(angleRad) * startRadius;
  const startY = -Math.sin(angleRad) * startRadius;

  const baseDelay = 45;
  const index = Math.max(0, orderedKeysForDelay.indexOf(key as (typeof orderedKeysForDelay)[number]));
  const delayMs = index * baseDelay;

  return { x, y, startX, startY, delayMs };
}

function titleForKey(key: string, fallback: string): string {
  switch (key) {
    case 'publicacoes':
      return 'PUBLICAÇÕES';
    case 'biblioteca':
      return 'BIBLIOTECA';
    case 'core':
      return 'CORE';
    case 'mediadora':
      return 'MEDIADORA';
    case 'mediadora-audio':
      return 'MEDIADORA ÁUDIO';
    case 'internacional':
      return 'INTERNACIONAL';
    default:
      return fallback.toUpperCase();
  }
}

function subtitleForKey(key: string): string {
  switch (key) {
    case 'publicacoes':
      return 'Ideias, observações e registros.';
    case 'biblioteca':
      return 'Conhecimento estruturado.';
    case 'core':
      return 'Núcleo da arquitetura e sistemas.';
    case 'mediadora':
      return 'Soluções de mediação e reorganização.';
    case 'mediadora-audio':
      return 'Música, direitos e criação.';
    case 'internacional':
      return 'Expansão e colaboração.';
    default:
      return '';
  }
}

function iconSvgForKey(key: string): string {
  switch (key) {
    case 'publicacoes':
      return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
  <path d="M7 3h7l3 3v15a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2Z" stroke="currentColor" stroke-width="1.6" />
  <path d="M14 3v4a1 1 0 0 0 1 1h4" stroke="currentColor" stroke-width="1.6" />
  <path d="M8 12h8M8 16h6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
</svg>`;
    case 'biblioteca':
      return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
  <path d="M6 4h9a3 3 0 0 1 3 3v13H8a2 2 0 0 0-2 2V4Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
  <path d="M6 20h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
</svg>`;
    case 'core':
      return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
  <path d="M12 2 21 7l-9 5-9-5 9-5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
  <path d="M3 7v10l9 5 9-5V7" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
  <path d="M12 12v10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
</svg>`;
    case 'mediadora':
      return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
  <path d="M8 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z" stroke="currentColor" stroke-width="1.6" />
  <path d="M16 12a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5Z" stroke="currentColor" stroke-width="1.6" />
  <path d="M4.5 20a4.5 4.5 0 0 1 9 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  <path d="M13.5 20a3.5 3.5 0 0 1 7 0" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
</svg>`;
    case 'mediadora-audio':
      return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
  <path d="M4 14c2 0 2-4 4-4s2 8 4 8 2-12 4-12 2 6 4 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
</svg>`;
    case 'internacional':
      return `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
  <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6" />
  <path d="M3 12h18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  <path d="M12 3c3 3 3 15 0 18M12 3c-3 3-3 15 0 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
</svg>`;
    default:
      return '';
  }
}
---

<div class="synora-halo" data-state="collapsed" aria-label={ariaLabel}>
	  <div class="synora-halo__stage">
	    <button class="synora-halo__core" type="button" aria-expanded="false" aria-controls="synora-halo-destinations">
	      <span class="synora-halo__sr">Abrir destinos</span>
	      <div class="synora-halo__core-surface" aria-hidden="true"></div>
	      <SynoraHaloSignature size={150} markSize={72} atmoScale={1.28} atmoOpacity={0.12} atmoOpacityPeak={0.26} />
	      <div class="synora-halo__core-subtitle" aria-hidden="true">Centro de inteligência e coordenação.</div>
	    </button>

    <div id="synora-halo-destinations" class="synora-halo__destinations" aria-label="Destinos">
      <svg class="synora-halo__links" viewBox="-280 -280 560 560" aria-hidden="true" focusable="false">
        {items.map((item) => {
          const pos = positionForKey(item.key);
          const disabled = Boolean(item.disabled);
          const accent = accentHexForKey(item.key);
          return (
            <line
              class:list={['synora-halo__link', disabled && 'is-disabled']}
              x1="0"
              y1="0"
              x2={pos.x}
              y2={pos.y}
              style={`--delay:${pos.delayMs}ms; --accent:${accent}; --accent-soft:${hexToRgba(accent, 0.16)};`}
            />
          );
        })}
      </svg>
      {items.map((item) => {
        const pos = positionForKey(item.key);
        const disabled = Boolean(item.disabled);
        const itemAriaLabel = item.disabledReason ? `${item.label}. ${item.disabledReason}` : item.label;
        const accent = accentHexForKey(item.key);
        const title = titleForKey(item.key, item.label);
        const subtitle = subtitleForKey(item.key);
        const icon = iconSvgForKey(item.key);
        return (
          <div
            class="synora-halo__satellite"
            style={`--x:${pos.x}px; --y:${pos.y}px; --sx:${pos.startX}px; --sy:${pos.startY}px; --delay:${pos.delayMs}ms; --accent:${accent}; --accent-soft:${hexToRgba(accent, 0.14)};`}
            data-key={item.key}
          >
            <a
              class:list={['synora-halo__destination', disabled && 'is-disabled']}
              href={disabled ? undefined : item.href}
              aria-label={itemAriaLabel}
              aria-disabled={disabled ? 'true' : undefined}
              tabindex={disabled ? '-1' : undefined}
            >
              <span class="synora-halo__orb" aria-hidden="true">
                {icon ? <span class="synora-halo__orb-icon" set:html={icon} /> : null}
                <span class="synora-halo__orb-title">{title}</span>
                {subtitle ? <span class="synora-halo__orb-subtitle">{subtitle}</span> : null}
              </span>
            </a>
          </div>
        );
      })}
    </div>
  </div>

  <nav class="synora-halo__fallback" aria-label="Destinos (lista)">
    <ul>
      {items.map((item) => (
        <li>
          {item.disabled ? (
            <span class="synora-halo__fallback-disabled" aria-disabled="true">
              {item.label}
            </span>
          ) : (
            <a href={item.href}>{item.label}</a>
          )}
        </li>
      ))}
    </ul>
  </nav>

  <noscript>
    <nav class="synora-halo__noscript" aria-label="Destinos (sem JavaScript)">
      <ul>
        {items.map((item) => (
          <li>
            {item.disabled ? (
              <span aria-disabled="true">{item.label}</span>
            ) : (
              <a href={item.href}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>
  </noscript>

  <div class="synora-halo__toast" role="status" aria-live="polite" aria-atomic="true"></div>
</div>

<script is:inline>
  (() => {
    const root = document.currentScript?.closest('.synora-halo');
    if (!root) return;

    const prefersReducedMotion =
      typeof window !== 'undefined' &&
      window.matchMedia &&
      window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	    const core = root.querySelector('.synora-halo__core');
	    const destinations = root.querySelector('.synora-halo__destinations');
	    const fallback = root.querySelector('.synora-halo__fallback');
	    const toast = root.querySelector('.synora-halo__toast');
	    const disabledLinks = root.querySelectorAll('.synora-halo__destination.is-disabled');
	    const destinationLinks = root.querySelectorAll('.synora-halo__destination');
      const satelliteEls = root.querySelectorAll('.synora-halo__satellite');
      const linkEls = root.querySelectorAll('.synora-halo__link');
      const linksSvg = root.querySelector('.synora-halo__links');

	    root.dataset.enhanced = 'true';

    if (fallback) {
      fallback.setAttribute('aria-hidden', prefersReducedMotion ? 'false' : 'true');
      if (!prefersReducedMotion) fallback.setAttribute('hidden', '');
    }

	    const setState = (next) => {
	      root.dataset.state = next;
	      if (core) core.setAttribute('aria-expanded', String(next === 'expanded'));
	      destinationLinks.forEach((link) => {
	        if (!(link instanceof HTMLAnchorElement)) return;
	        if (link.classList.contains('is-disabled')) return;
	        if (next === 'expanded') {
	          link.removeAttribute('tabindex');
	          link.removeAttribute('aria-hidden');
	        } else {
	          link.setAttribute('tabindex', '-1');
	          link.setAttribute('aria-hidden', 'true');
	        }
	      });
	      if (fallback) {
	        fallback.setAttribute('aria-hidden', next === 'expanded' ? 'true' : prefersReducedMotion ? 'false' : 'true');
	        if (!prefersReducedMotion) fallback.setAttribute('hidden', '');
	        else fallback.removeAttribute('hidden');
	      }
	    };

	    const toggle = () => {
	      const state = root.dataset.state || 'collapsed';
	      setState(state === 'expanded' ? 'collapsed' : 'expanded');
	    };
	
	    setState(root.dataset.state || 'collapsed');

      const prefersDesktopExpanded =
        typeof window !== 'undefined' &&
        window.matchMedia &&
        window.matchMedia('(min-width: 900px)').matches &&
        !prefersReducedMotion;

      const applyDesktopGeometry = () => {
        if (!prefersDesktopExpanded) return;
        if (!satelliteEls.length) return;

        // Desktop/tablet largo: abrir composição orbital usando mais área útil.
        const scaleX = 1.95;
        const scaleY = 1.35;

        satelliteEls.forEach((el, index) => {
          if (!(el instanceof HTMLElement)) return;
          const style = el.style;
          const x = Number.parseFloat(style.getPropertyValue('--x')) || 0;
          const y = Number.parseFloat(style.getPropertyValue('--y')) || 0;
          const sx = Number.parseFloat(style.getPropertyValue('--sx')) || 0;
          const sy = Number.parseFloat(style.getPropertyValue('--sy')) || 0;
          const nx = x * scaleX;
          const ny = y * scaleY;
          const nsx = sx * scaleX;
          const nsy = sy * scaleY;
          style.setProperty('--x', `${nx}px`);
          style.setProperty('--y', `${ny}px`);
          style.setProperty('--sx', `${nsx}px`);
          style.setProperty('--sy', `${nsy}px`);

          const line = linkEls[index];
          if (line && line.setAttribute) {
            line.setAttribute('x2', String(nx));
            line.setAttribute('y2', String(ny));
          }
        });

        if (linksSvg && linksSvg.setAttribute) {
          linksSvg.setAttribute('viewBox', '-560 -420 1120 840');
        }
      };

	    if (core && !prefersReducedMotion) {
	      core.addEventListener('click', (event) => {
	        event.preventDefault();
	        toggle();
	      });
    }

    if (prefersReducedMotion) {
      setState('collapsed');
      root.dataset.reduced = 'true';
      if (core) {
        core.addEventListener('click', (event) => {
          event.preventDefault();
          toggle();
        });
      }
    }

    root.addEventListener('click', (event) => {
      if (!destinations) return;
      const target = event.target;
      if (!(target instanceof Element)) return;
      if (target.closest('.synora-halo__destination')) return;
      if (target.closest('.synora-halo__core')) return;
      if ((root.dataset.state || 'collapsed') === 'expanded') setState('collapsed');
    });

    disabledLinks.forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        const message = link.getAttribute('aria-label') || 'Destino indisponível.';
        if (toast) {
          toast.textContent = message;
          toast.classList.add('is-visible');
          window.clearTimeout(toast.__t);
          toast.__t = window.setTimeout(() => toast.classList.remove('is-visible'), 1800);
        }
      });
    });

    const shouldStartExpanded =
      typeof window !== 'undefined' &&
      (window.location.hash === '#expanded' || new URLSearchParams(window.location.search).get('halo') === 'expanded');

    const demoDelayMs =
      typeof window !== 'undefined' && new URLSearchParams(window.location.search).get('demo') === '1' ? 700 : 0;

    if (shouldStartExpanded || prefersDesktopExpanded) {
      if (demoDelayMs > 0 && !prefersReducedMotion) window.setTimeout(() => setState('expanded'), demoDelayMs);
      else setState('expanded');
    }

    applyDesktopGeometry();
  })();
</script>

<style>
  .synora-halo {
    width: min(720px, 100%);
    display: grid;
    gap: 0;
    justify-items: center;
    position: relative;
    padding: 0;
    --halo-shift-y: 0px;
  }

	  .synora-halo__stage {
	    position: relative;
	    width: min(calc(100% - 24px), 420px);
	    height: 780px;
	    display: grid;
	    place-items: center;
      transform: translateY(var(--halo-shift-y));
	  }

  .synora-halo__core {
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    display: grid;
    place-items: center;
    border-radius: 999px;
    width: min(360px, 86vw);
    aspect-ratio: 1 / 1;
    touch-action: manipulation;
    position: relative;
    gap: 12px;
  }

  .synora-halo__core:focus-visible {
    outline: 2px solid rgba(79, 209, 255, 0.52);
    outline-offset: 8px;
  }

  .synora-halo__core-surface {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: radial-gradient(circle at 50% 40%, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0) 62%);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.04) inset,
      0 32px 78px rgba(0, 0, 0, 0.38),
      0 0 0 1px rgba(255, 233, 180, 0.12);
    pointer-events: none;
  }

	  .synora-halo__core-surface::before {
	    content: '';
	    position: absolute;
	    inset: -52px;
	    border-radius: 999px;
	    border: 0;
	    background: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.08), rgba(48, 79, 254, 0.06) 38%, transparent 72%);
	    filter: blur(26px);
	    opacity: 0.42;
	    pointer-events: none;
	  }

	  .synora-halo__core-label {
	    position: absolute;
	    left: 50%;
	    top: calc(50% + 70px);
	    transform: translateX(-50%);
	    letter-spacing: 0.26em;
	    font-size: 13px;
	    font-weight: 700;
	    color: rgba(255, 255, 255, 0.74);
	    text-transform: uppercase;
	  }

	  .synora-halo__core-subtitle {
	    display: none;
	    position: absolute;
	    left: 50%;
	    top: calc(50% + 96px);
	    transform: translateX(-50%);
	    font-size: 12px;
	    color: rgba(140, 170, 255, 0.6);
	    text-align: center;
	    width: min(240px, 78vw);
	    line-height: 1.25;
	    text-shadow: 0 1px 0 rgba(0, 0, 0, 0.5);
	  }

  .synora-halo__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

	  .synora-halo__destinations {
	    position: absolute;
	    inset: 0;
	    display: grid;
	    place-items: center;
	    pointer-events: none;
	  }

	  .synora-halo__orb-subtitle {
	    display: none;
	  }

	  .synora-halo__links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
	    opacity: 0;
	    transition: opacity 260ms ease-out;
	    pointer-events: none;
	  }

	  .synora-halo__link {
	    stroke: var(--accent-soft, rgba(79, 209, 255, 0.14));
	    stroke-width: 1;
	    stroke-linecap: round;
	    stroke-dasharray: none;
	    opacity: 0.18;
	    filter: drop-shadow(0 0 16px color-mix(in srgb, var(--accent, #4fd1ff) 10%, transparent));
	  }

  .synora-halo__link.is-disabled {
    opacity: 0.35;
  }

  .synora-halo__link {
    stroke-dashoffset: 28;
    animation: none;
  }

  .synora-halo__satellite {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) translate(var(--sx), var(--sy)) scale(0.9);
    opacity: 0;
    filter: blur(2px);
    pointer-events: none;
    transition: transform 640ms cubic-bezier(0.18, 0.84, 0.22, 1), opacity 360ms ease-out;
    transition-delay: var(--delay);
    will-change: transform, opacity;
  }

	  .synora-halo__destination {
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 10px;
    background: transparent;
    border: 0;
    color: rgba(255, 255, 255, 0.92);
    font-size: 12px;
    letter-spacing: 0.01em;
	    transform: scale(0.92);
    transition:
      transform 640ms cubic-bezier(0.18, 0.84, 0.22, 1),
      background 180ms ease-out,
      border-color 180ms ease-out,
      opacity 360ms ease-out;
    transition:
      transform 640ms cubic-bezier(0.18, 0.84, 0.22, 1),
      background 180ms ease-out,
      border-color 180ms ease-out,
      opacity 360ms ease-out;
  }

	  .synora-halo__orb {
      position: relative;
	    width: 108px;
	    height: 108px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent, #4fd1ff) 62%, rgba(255, 255, 255, 0.14));
    background:
      radial-gradient(circle at 38% 32%, rgba(255, 255, 255, 0.12), rgba(255, 255, 255, 0) 46%),
      radial-gradient(circle at 56% 64%, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.18) 58%, rgba(0, 0, 0, 0.34) 80%),
      radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--accent, #4fd1ff) 15%, rgba(2, 11, 24, 0.14)), rgba(2, 11, 24, 0.62) 66%);
	    box-shadow:
	      0 0 0 1px rgba(255, 255, 255, 0.06) inset,
	      0 1px 0 rgba(255, 255, 255, 0.04) inset,
	      0 -10px 18px rgba(0, 0, 0, 0.18) inset,
	      0 10px 22px rgba(0, 0, 0, 0.24),
	      0 18px 48px rgba(0, 0, 0, 0.24),
	      0 0 14px color-mix(in srgb, var(--accent, #4fd1ff) 12%, transparent);
	    backdrop-filter: blur(8px) saturate(0.92);
	    display: grid;
	    place-items: center;
	    text-align: center;
	    padding: 14px 14px 12px;
	    gap: 6px;
	    color: color-mix(in srgb, var(--accent, #4fd1ff) 82%, rgba(255, 255, 255, 0.2));
	  }

    .synora-halo__orb::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 999px;
      background:
        radial-gradient(circle at 36% 30%, rgba(255, 255, 255, 0.10), rgba(255, 255, 255, 0) 44%),
        radial-gradient(circle at 72% 70%, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0) 52%),
        radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.03) 64%, rgba(255, 255, 255, 0) 86%);
      opacity: 0.55;
      pointer-events: none;
    }

	  .synora-halo__orb-icon {
    display: grid;
    place-items: center;
	    width: 28px;
	    height: 28px;
    color: inherit;
    opacity: 0.95;
    filter: drop-shadow(0 0 10px color-mix(in srgb, var(--accent, #4fd1ff) 22%, transparent));
  }

	  .synora-halo__orb-title {
	    font-size: 11px;
	    letter-spacing: 0.12em;
	    font-weight: 700;
	    color: rgba(255, 255, 255, 0.94);
	    text-transform: uppercase;
