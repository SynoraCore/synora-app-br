---
type Props = {
  size?: number;
  markSize?: number;
  src?: string;
  atmoScale?: number;
};

const { size = 62, markSize = 32, src = '/brand/synora-mark.svg', atmoScale = 2.75 } = Astro.props;
---

<div
  class="synora-halo-signature"
  style={`--halo-size:${size}px; --mark-size:${markSize}px; --atmo-scale:${atmoScale};`}
  aria-hidden="true"
>
  <div class="synora-halo-signature__halo-atmo"></div>
  <div class="synora-halo-signature__halo-main"></div>
  <div class="synora-halo-signature__core">
    <div class="synora-halo-signature__inner-ring" aria-hidden="true"></div>
    <img class="synora-halo-signature__mark" src={src} alt="" width={markSize} height={markSize} loading="eager" decoding="async" />
  </div>
</div>

<style>
  .synora-halo-signature {
    width: var(--halo-size);
    height: var(--halo-size);
    display: grid;
    place-items: center;
    position: relative;
    isolation: isolate;
  }

  .synora-halo-signature__core {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
    position: relative;
    z-index: 3;
  }

  .synora-halo-signature__inner-ring {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    border: 0.75px solid rgba(255, 255, 255, 0.14);
    opacity: 0.95;
    pointer-events: none;
  }

  .synora-halo-signature__mark {
    width: var(--mark-size);
    height: var(--mark-size);
    display: block;
    position: relative;
    z-index: 1;
  }

  .synora-halo-signature__halo-main,
  .synora-halo-signature__halo-atmo {
    position: absolute;
    border-radius: 999px;
    pointer-events: none;
    transform-origin: center;
    inset: 0;
    will-change: transform, opacity;
  }

  .synora-halo-signature__halo-main {
    z-index: 1;
    inset: -18px;
    background:
      radial-gradient(
        circle at 50% 50%,
        rgba(56, 189, 248, 0.34),
        rgba(56, 189, 248, 0.14) 40%,
        rgba(56, 189, 248, 0.06) 62%,
        rgba(56, 189, 248, 0) 84%
      );
    opacity: 0.1;
    filter: blur(10px);
  }

  .synora-halo-signature__halo-atmo {
    z-index: 2;
    width: calc(var(--halo-size) * var(--atmo-scale));
    height: calc(var(--halo-size) * var(--atmo-scale));
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) scale(1.008);
    background:
      radial-gradient(
        circle at 50% 50%,
        rgba(56, 189, 248, 0.2),
        rgba(56, 189, 248, 0.085) 28%,
        rgba(56, 189, 248, 0.035) 46%,
        rgba(56, 189, 248, 0.015) 62%,
        rgba(56, 189, 248, 0) 78%
      );
    opacity: 0.17;
    filter: blur(20px);
    will-change: transform, opacity, filter;
    animation: synora-halo-atmo-breathe 10s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  @keyframes synora-halo-atmo-breathe {
    0% {
      transform: translate(-50%, -50%) scale(1.008);
      opacity: 0.17;
      filter: blur(20px);
    }
    45% {
      transform: translate(-50%, -50%) scale(1.02);
      opacity: 0.33;
      filter: blur(34px);
    }
    50% {
      transform: translate(-50%, -50%) scale(1.02);
      opacity: 0.33;
      filter: blur(34px);
    }
    95% {
      transform: translate(-50%, -50%) scale(1.008);
      opacity: 0.17;
      filter: blur(20px);
    }
    100% {
      transform: translate(-50%, -50%) scale(1.008);
      opacity: 0.17;
      filter: blur(20px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .synora-halo-signature__halo-atmo {
      animation: none;
    }

    .synora-halo-signature__halo-atmo {
      opacity: 0.22;
      transform: translate(-50%, -50%) scale(1.012);
      filter: blur(26px);
    }
  }
</style>
