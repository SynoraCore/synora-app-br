---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';

type Props = {
  title: string;
  description: string;
  path?: string;
  lang?: string;
  alternates?: Array<{ href: string; hreflang: string }>;
};

const { title, description, path = '/', lang = 'pt-BR', alternates = [] } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <SeoHead title={title} description={description} path={path} alternates={alternates} />
  </head>
  <body>
    <slot />
    <script is:inline type="module">
      const STORAGE = {
        restoreUrl: 'synora:door:restoreUrl',
        restoreScrollY: 'synora:door:restoreScrollY',
        enter: 'synora:door:enter',
      };

      const prefersReducedMotion =
        typeof window !== 'undefined' &&
        window.matchMedia &&
        window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const prefersSimpleDoor =
        typeof window !== 'undefined' &&
        window.matchMedia &&
        window.matchMedia('(hover: none) and (pointer: coarse)').matches;

      const isChromiumLike =
        typeof navigator !== 'undefined' &&
        typeof navigator.userAgent === 'string' &&
        /(Chrome|Chromium|OPR|Edg)\//.test(navigator.userAgent);

      function clamp(value, min, max) {
        return Math.max(min, Math.min(max, value));
      }

      function getTargetRect() {
        const sidePad = Math.max(22, Math.min(window.innerWidth * 0.054, 80));
        const maxWidth = Math.min(740, window.innerWidth - sidePad * 2);
        const width = maxWidth;
        const height = Math.min(window.innerHeight * 0.72, 720);
        const left = (window.innerWidth - width) / 2;
        const top = Math.max(84, (window.innerHeight - height) / 2);
        return { left, top, width, height };
      }

      function ensureDoorOverlay() {
        let overlay = document.querySelector('[data-door-overlay]');
        if (!overlay) {
          overlay = document.createElement('div');
          overlay.dataset.doorOverlay = 'true';
          overlay.className = 'door-overlay';
          document.body.appendChild(overlay);
        }
        return overlay;
      }

      function lockBody(lock) {
        if (lock) document.documentElement.classList.add('is-door');
        else document.documentElement.classList.remove('is-door');
      }

      function animateDoorFromCard(link) {
        const overlay = ensureDoorOverlay();
        lockBody(true);

        const rect = link.getBoundingClientRect();
        const clone = link.cloneNode(true);
        clone.removeAttribute('href');
        clone.classList.add('door-card');
        clone.setAttribute('aria-hidden', 'true');
        clone.style.position = 'fixed';
        clone.style.left = rect.left + 'px';
        clone.style.top = rect.top + 'px';
        clone.style.width = rect.width + 'px';
        clone.style.height = rect.height + 'px';
        clone.style.margin = '0';
        clone.style.zIndex = '1001';
        document.body.appendChild(clone);

        const target = getTargetRect();
        const morphMs = 300;
        const pauseMs = 160;
        const scaleX = target.width / Math.max(1, rect.width);
        const scaleY = target.height / Math.max(1, rect.height);

        overlay.animate(
          [{ opacity: 0 }, { opacity: 1 }],
          { duration: 220, easing: 'ease-out', fill: 'forwards' }
        );

        const morph = clone.animate(
          [
            {
              transform: 'translate3d(0,0,0) scale(1, 1)',
              borderRadius: getComputedStyle(document.documentElement).getPropertyValue('--radius') || '20px',
            },
            {
              transform: `translate3d(${target.left - rect.left}px, ${target.top - rect.top}px, 0) scale(${scaleX}, ${scaleY})`,
            },
          ],
          { duration: morphMs, easing: 'cubic-bezier(.2,.9,.2,1)', fill: 'forwards' }
        );

        return morph.finished
          .catch(() => {})
          .then(() => new Promise((r) => setTimeout(r, pauseMs)))
          .finally(() => {
            clone.remove();
          });
      }

      function animateDoorReduced() {
        const overlay = ensureDoorOverlay();
        lockBody(true);
        overlay.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 120, easing: 'linear', fill: 'forwards' });
        return new Promise((r) => setTimeout(r, 140));
      }

      function ensurePaperOverlay() {
        let overlay = document.querySelector('[data-paper-overlay]');
        if (!overlay) {
          overlay = document.createElement('div');
          overlay.dataset.paperOverlay = 'true';
          overlay.className = 'paper-overlay';

          const sheet = document.createElement('div');
          sheet.className = 'paper-sheet';
          sheet.setAttribute('role', 'dialog');
          sheet.setAttribute('aria-modal', 'true');
          sheet.tabIndex = -1;
          overlay.appendChild(sheet);

          const head = document.createElement('div');
          head.className = 'paper-head';

          const close = document.createElement('button');
          close.type = 'button';
          close.className = 'paper-close';
          close.textContent = '← Continuar explorando';
          close.addEventListener('click', () => closePaperOverlay({ restore: true }));
          head.appendChild(close);

          sheet.appendChild(head);

          const body = document.createElement('div');
          body.className = 'paper-body';
          sheet.appendChild(body);

          document.body.appendChild(overlay);
        }
        return overlay;
      }

      function closePaperOverlay({ restore } = { restore: true }) {
        const overlay = document.querySelector('[data-paper-overlay]');
        if (!overlay) return;

        try {
          document.documentElement.classList.remove('is-paper-open');
        } catch {}

        overlay.remove();

        if (!restore) return;

        let target = '/';
        try {
          const restoreUrl = sessionStorage.getItem(STORAGE.restoreUrl);
          if (restoreUrl) target = restoreUrl;
        } catch {}

        try {
          history.replaceState(null, '', target);
        } catch {}

        restoreScrollIfNeeded();
      }

      async function openPaperOverlay(href) {
        const overlay = ensurePaperOverlay();
        const sheet = overlay.querySelector('.paper-sheet');
        const body = overlay.querySelector('.paper-body');
        if (!(sheet instanceof HTMLElement) || !(body instanceof HTMLElement)) {
          window.location.assign(href);
          return;
        }

        body.innerHTML = '';
        document.documentElement.classList.add('is-paper-open');

        try {
          const res = await fetch(href, { headers: { Accept: 'text/html' } });
          if (!res.ok) throw new Error('fetch failed');
          const html = await res.text();
          const doc = new DOMParser().parseFromString(html, 'text/html');
          const main = doc.querySelector('main.conversation-shell') || doc.querySelector('main');
          if (!main) throw new Error('missing main');
          body.innerHTML = main.innerHTML;
        } catch {
          closePaperOverlay({ restore: false });
          window.location.assign(href);
          return;
        }

        try {
          history.pushState({ paper: '1', href }, '', href);
        } catch {}

        try {
          sheet.focus();
        } catch {}
      }

      function setupPaperNavigation() {
        window.addEventListener('popstate', () => {
          const isOpen = document.documentElement.classList.contains('is-paper-open');
          if (isOpen) closePaperOverlay({ restore: false });
        });

        window.addEventListener('keydown', (event) => {
          if (!(event instanceof KeyboardEvent)) return;
          if (event.key !== 'Escape') return;
          const isOpen = document.documentElement.classList.contains('is-paper-open');
          if (!isOpen) return;
          event.preventDefault();
          closePaperOverlay({ restore: true });
        });

        document.addEventListener('click', (event) => {
          const target = event.target && event.target.closest ? event.target.closest('a[data-explore-back]') : null;
          if (!target) return;
          const isOpen = document.documentElement.classList.contains('is-paper-open');
          if (!isOpen) return;
          event.preventDefault();
          closePaperOverlay({ restore: true });
        });
      }

      function setupDoorLinks() {
        if (prefersSimpleDoor || isChromiumLike) return;
        const links = Array.from(document.querySelectorAll('a[data-door]'));
        if (!links.length) return;

        for (const link of links) {
          link.addEventListener('click', (event) => {
            if (!(event instanceof MouseEvent)) return;
            if (event.defaultPrevented) return;
            if (event.button !== 0) return;
            if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

            const href = link.getAttribute('href');
            if (!href) return;

            event.preventDefault();

            try {
              sessionStorage.setItem(STORAGE.restoreUrl, window.location.pathname + window.location.search + window.location.hash);
              sessionStorage.setItem(STORAGE.restoreScrollY, String(window.scrollY || 0));
              sessionStorage.setItem(STORAGE.enter, '1');
            } catch {}

            let run;
            try {
              run = prefersReducedMotion || prefersSimpleDoor ? animateDoorReduced() : animateDoorFromCard(link);
            } catch {
              try {
                document.querySelector('[data-door-overlay]')?.remove();
              } catch {}
              lockBody(false);
              window.location.assign(href);
              return;
            }
            Promise.resolve(run)
              .catch(() => {})
              .finally(() => {
                try {
                  document.querySelector('[data-door-overlay]')?.remove();
                } catch {}
                lockBody(false);
                openPaperOverlay(href);
              });
          });
        }
      }

      function setupExploreBack() {
        if (prefersSimpleDoor || isChromiumLike) return;
        const backLinks = Array.from(document.querySelectorAll('a[data-explore-back]'));
        for (const link of backLinks) {
          link.addEventListener('click', (event) => {
            if (!(event instanceof MouseEvent)) return;
            if (event.defaultPrevented) return;
            if (event.button !== 0) return;
            if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

            const fallback = link.getAttribute('href') || '/';
            event.preventDefault();

            let target = fallback;
            try {
              const restoreUrl = sessionStorage.getItem(STORAGE.restoreUrl);
              if (restoreUrl) target = restoreUrl;
            } catch {}

            window.location.assign(target);
          });
        }
      }

      function restoreScrollIfNeeded() {
        try {
          const restoreUrl = sessionStorage.getItem(STORAGE.restoreUrl);
          const restoreScrollY = sessionStorage.getItem(STORAGE.restoreScrollY);
          if (!restoreUrl || restoreScrollY == null) return;

          const here = window.location.pathname + window.location.search + window.location.hash;
          if (here !== restoreUrl) return;

          sessionStorage.removeItem(STORAGE.restoreUrl);
          sessionStorage.removeItem(STORAGE.restoreScrollY);

          const y = clamp(Number(restoreScrollY) || 0, 0, document.body.scrollHeight);
          requestAnimationFrame(() => {
            window.scrollTo({ top: y, behavior: 'auto' });
          });
        } catch {}
      }

      function markDoorEnter() {
        try {
          const enter = sessionStorage.getItem(STORAGE.enter);
          if (enter !== '1') return;
          sessionStorage.removeItem(STORAGE.enter);
          document.documentElement.classList.add('is-door-enter');
          window.setTimeout(() => document.documentElement.classList.remove('is-door-enter'), 1400);
        } catch {}
      }

      setupDoorLinks();
      setupPaperNavigation();
      setupExploreBack();
      restoreScrollIfNeeded();
      markDoorEnter();
    </script>
  </body>
</html>
