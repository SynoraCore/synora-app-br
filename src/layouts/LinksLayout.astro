---
import SeoHead from '../components/SeoHead.astro';

type Props = {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  robots?: string;
};

const { title, description, path, ogImage, robots } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead title={title} description={description} path={path} ogImage={ogImage} themeColor="#0B1220" robots={robots} />
    <style is:global>
      :root {
        --bg: #0b1220;
        --text: #ffffff;
        --muted: rgba(255, 255, 255, 0.72);
        --line: rgba(255, 255, 255, 0.12);
        --surface: rgba(255, 255, 255, 0.04);
        --surface-hover: rgba(255, 255, 255, 0.07);
        --radius: 16px;
        --max: 420px;
        --pad: clamp(18px, 5vw, 28px);
        --accent: rgba(56, 189, 248, 0.55);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        height: 100%;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        display: grid;
        place-items: center;
        padding: 28px var(--pad);
        text-rendering: geometricPrecision;
      }

      .wrap {
        width: min(var(--max), 100%);
        display: grid;
        gap: 18px;
      }

      .brand {
        display: grid;
        justify-items: center;
        text-align: center;
        gap: 12px;
        padding: 18px 12px 0;
      }

      .logo {
        width: 62px;
        height: 62px;
        display: grid;
        place-items: center;
      }

      .logo img {
        width: 32px;
        height: 32px;
        display: block;
      }

      h1 {
        margin: 0;
        font-size: 24px;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      .tagline {
        margin: 0;
        font-size: 14px;
        line-height: 1.4;
        color: var(--muted);
      }

      .intro {
        margin: 0;
        font-size: 13px;
        line-height: 1.45;
        color: rgba(255, 255, 255, 0.66);
      }

      .rule {
        width: 100%;
        height: 1px;
        background: var(--line);
        margin: 10px 0 0;
      }

      .list {
        display: grid;
        gap: 10px;
        padding: 6px 0 0;
      }

      .link {
        width: 100%;
        max-width: var(--max);
        display: grid;
        grid-template-columns: 28px 1fr auto;
        align-items: center;
        gap: 12px;
        padding: 14px 42px 14px 14px;
        border-radius: var(--radius);
        border: 1px solid var(--line);
        background: var(--surface);
        color: inherit;
        text-decoration: none;
        position: relative;
        box-shadow: none;
        transition:
          background 200ms cubic-bezier(0.45, 0, 0.55, 1),
          border-color 200ms cubic-bezier(0.45, 0, 0.55, 1),
          transform 200ms cubic-bezier(0.45, 0, 0.55, 1),
          box-shadow 200ms cubic-bezier(0.45, 0, 0.55, 1);
        -webkit-tap-highlight-color: transparent;
      }

      @media (hover: hover) and (pointer: fine) {
        .link:hover {
          background: var(--surface-hover);
          border-color: rgba(56, 189, 248, 0.22);
          transform: translateY(-2px);
          box-shadow: 0 10px 26px rgba(0, 0, 0, 0.18);
        }
      }

      .link:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .link::after {
        content: "→";
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        font-size: 14px;
        color: rgba(255, 255, 255, 0.6);
        transition: color 200ms cubic-bezier(0.45, 0, 0.55, 1);
      }

      @media (hover: hover) and (pointer: fine) {
        .link:hover::after {
          color: rgba(255, 255, 255, 0.74);
        }
      }

      .icon {
        display: grid;
        place-items: center;
        width: 28px;
        height: 28px;
        color: rgba(255, 255, 255, 0.86);
        transition: color 200ms cubic-bezier(0.45, 0, 0.55, 1);
      }

      @media (hover: hover) and (pointer: fine) {
        .link:hover .icon {
          color: rgba(255, 255, 255, 0.96);
        }
      }

      .icon svg {
        width: 18px;
        height: 18px;
      }

      .label {
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 0.01em;
      }

      .note {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.52);
        justify-self: end;
        margin-right: 16px;
      }

      .is-placeholder {
        opacity: 0.55;
        cursor: default;
      }

      .is-placeholder:hover {
        background: var(--surface);
        border-color: var(--line);
        transform: none;
        box-shadow: none;
      }

      .is-placeholder::after,
      .is-placeholder:hover::after {
        content: "";
      }

      .foot {
        padding-top: 12px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        font-size: 12px;
        color: rgba(255, 255, 255, 0.5);
        text-align: center;
        display: grid;
        gap: 2px;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
