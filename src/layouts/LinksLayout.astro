---
import SeoHead from '../components/SeoHead.astro';

type Props = {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  robots?: string;
};

const { title, description, path, ogImage, robots } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead title={title} description={description} path={path} ogImage={ogImage} themeColor="#0B1220" robots={robots} />
    <style is:global>
      :root {
        --bg: #0b1220;
        --text: #ffffff;
        --muted: rgba(255, 255, 255, 0.72);
        --line: rgba(255, 255, 255, 0.12);
        --surface: rgba(255, 255, 255, 0.04);
        --surface-hover: rgba(255, 255, 255, 0.06);
        --radius: 16px;
        --max: 420px;
        --pad: clamp(18px, 5vw, 28px);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        height: 100%;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        display: grid;
        place-items: center;
        padding: 28px var(--pad);
        text-rendering: geometricPrecision;
      }

      .wrap {
        width: min(var(--max), 100%);
        display: grid;
        gap: 18px;
      }

      .brand {
        display: grid;
        justify-items: center;
        text-align: center;
        gap: 12px;
        padding: 18px 12px 10px;
        border-bottom: 1px solid var(--line);
      }

      .logo {
        width: 52px;
        height: 52px;
        display: grid;
        place-items: center;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.02);
      }

      .logo img {
        width: 28px;
        height: 28px;
        display: block;
      }

      h1 {
        margin: 0;
        font-size: 24px;
        font-weight: 600;
        letter-spacing: -0.01em;
      }

      .tagline {
        margin: 0;
        font-size: 14px;
        line-height: 1.4;
        color: var(--muted);
      }

      .list {
        display: grid;
        gap: 10px;
        padding: 6px 0 0;
      }

      .link {
        width: 100%;
        max-width: var(--max);
        display: grid;
        grid-template-columns: 28px 1fr auto;
        align-items: center;
        gap: 12px;
        padding: 14px 14px;
        border-radius: var(--radius);
        border: 1px solid var(--line);
        background: var(--surface);
        color: inherit;
        text-decoration: none;
        transition: background 180ms ease, border-color 180ms ease, transform 180ms ease;
        -webkit-tap-highlight-color: transparent;
      }

      .link:hover {
        background: var(--surface-hover);
        border-color: rgba(255, 255, 255, 0.18);
        transform: translateY(-1px);
      }

      .link:focus-visible {
        outline: 2px solid rgba(56, 189, 248, 0.55);
        outline-offset: 2px;
      }

      .icon {
        display: grid;
        place-items: center;
        width: 28px;
        height: 28px;
        font-size: 16px;
      }

      .label {
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 0.01em;
      }

      .note {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.52);
      }

      .is-placeholder {
        opacity: 0.55;
        cursor: default;
      }

      .is-placeholder:hover {
        background: var(--surface);
        border-color: var(--line);
        transform: none;
      }

      .foot {
        padding-top: 12px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        font-size: 12px;
        color: rgba(255, 255, 255, 0.5);
        text-align: center;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
