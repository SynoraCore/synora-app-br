---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PublicationHead from '../components/PublicationHead.astro';
import '../styles/publicacoes.css';

type Props = {
  title: string;
  description: string;
  path?: string;
  lang?: string;
  alternates?: Array<{ href: string; hreflang: string }>;
  ogType?: 'website' | 'article';
  head?: {
    ogImage?: string;
    twitterImage?: string;
    publishedTime?: string;
    modifiedTime?: string;
  };
};

const { title, description, path = '/', lang, alternates, ogType, head } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  lang={lang}
  alternates={alternates}
  ogType={ogType}
>
  <PublicationHead slot="head" {...head} />
  <main class="pub-main">
    <slot />
  </main>
</BaseLayout>
