---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteFooter from '../../../../components/SiteFooter.astro';
import SiteNav from '../../../../components/SiteNav.astro';
import { CONTENT, LOCALES, isLocale } from '../../../../i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { lang: locale } }));
}

const localeParam = Astro.params.lang;
if (!isLocale(localeParam)) {
  throw new Error(`Invalid locale: ${localeParam}`);
}

const locale = localeParam;
const content = CONTENT[locale];

const copy =
  locale === 'pt'
    ? {
        eyebrow: 'Synora Audio',
        title: 'Quando foi a última vez que vocês fecharam um mês… sem virar investigação?',
        description:
          'Na teoria, parece simples. Na prática: “eu achei que isso já tinha sido pago”, “manda o link de novo”, “calma… deixa eu achar a mensagem”.',
        act1: [
          { type: 'p', text: 'Na teoria, parece simples.' },
          { type: 'p', text: 'Na prática:' },
          {
            type: 'ul',
            items: [
              '“Eu achei que isso já tinha sido pago.”',
              '“Tem o comprovante… só não sei onde.”',
              '“Qual planilha é a última mesmo?”',
              '“A versão certa… tá no meu computador.”',
              '“Cada um lembra uma porcentagem.”',
              '“O combinado era esse… ou era outro?”',
              '“Manda o link de novo.”',
              '“Calma… deixa eu achar a mensagem.”',
            ],
          },
          { type: 'p', text: 'E aí...' },
          { type: 'p', text: 'sem ninguém perceber...' },
          { type: 'p', text: 'o mês muda de assunto.' },
          { type: 'p', text: 'Não é sobre áudio.' },
          { type: 'p', text: 'Não é sobre arte.' },
          { type: 'p', text: 'Nem é sobre dinheiro.' },
          { type: 'p', text: 'É sobre reconstruir uma história.' },
          { type: 'p', text: 'Quem participou.' },
          { type: 'p', text: 'Quem decidiu.' },
          { type: 'p', text: 'O que foi aprovado.' },
          { type: 'p', text: 'O que mudou.' },
          { type: 'p', text: 'O que ficou registrado.' },
          { type: 'p', text: '(…)' },
          {
            type: 'p',
            text: 'E quando cada pessoa lembra uma história diferente… até dividir o dinheiro vira briga.',
          },
          { type: 'p', text: 'Talvez o problema nunca tenha sido a planilha.' },
          {
            type: 'p',
            text: 'Talvez ela só esteja tentando juntar uma história que ficou espalhada em mensagens, links, arquivos e planilhas.',
          },
        ],
        act1Cta: 'Continuar lendo',
        act2Title: 'Se eu te pedisse agora…',
        act2: [
          { type: 'p', text: '“Me mostra o que aconteceu nesse lançamento — do começo ao fim.”' },
          { type: 'p', text: 'Qual foi o primeiro lugar que veio à tua cabeça?' },
          { type: 'p', text: 'WhatsApp?' },
          { type: 'p', text: 'Drive?' },
          { type: 'p', text: 'E-mail?' },
          { type: 'p', text: 'E em que momento costuma aparecer:' },
          { type: 'p', text: '“Pera… isso tá em outro lugar.”' },
          { type: 'p', text: '(…)' },
          { type: 'p', text: 'E no final…' },
          { type: 'p', text: 'o mês fecha.' },
          { type: 'p', text: 'Mas…' },
          { type: 'p', text: 'como ele costuma fechar?' },
          {
            type: 'p',
            text: '(Algumas equipes fecham no silêncio. Outras fecham no cansaço. Outras fecham na discussão. Qual é o teu caso?)',
          },
        ],
        ctaPrimary: 'Entrar na página oficial do Audio',
        ctaSecondary: '← Continuar explorando',
      }
    : locale === 'es'
      ? {
          eyebrow: 'Synora Audio',
          title: 'Conversación',
          description: 'Antes que nada: te haré una pregunta rápida. Responde a tu ritmo.',
          act1: [
            { type: 'p', text: '(Silencio.)' },
            { type: 'p', text: '¿Qué sonido le falta hoy a tu ecosistema?' },
          ],
          act1Cta: 'Seguir leyendo',
          act2Title: ' ',
          act2: [],
          ctaPrimary: 'Ir a la página oficial de Audio',
          ctaSecondary: '← Seguir explorando',
        }
      : {
          eyebrow: 'Synora Audio',
          title: 'Conversation',
          description: 'Before anything: I’ll ask you a quick question. Answer at your pace.',
          act1: [
            { type: 'p', text: '(Silence.)' },
            { type: 'p', text: 'What sound is missing from your ecosystem today?' },
          ],
          act1Cta: 'Keep reading',
          act2Title: ' ',
          act2: [],
          ctaPrimary: 'Go to the official Audio page',
          ctaSecondary: '← Keep exploring',
        };

const pageTitle = `${copy.eyebrow} — Conversa`;
const pageDescription = copy.description;
const path = `${content.routes.audio.path}/conversa`;

const alternates = [
  { hreflang: 'pt-BR', href: `/pt/audio/conversa` },
  { hreflang: 'es', href: `/es/audio/conversa` },
  { hreflang: 'en', href: `/en/audio/conversa` },
  { hreflang: 'x-default', href: '/' },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  path={path}
  lang={content.lang}
  alternates={alternates}
>
  <SiteNav locale={locale} routeKey="audio" />

  <div class="shell explore-shell">
    <a class="explore-back" href={`${content.routes.home.path}#solucoes`}>
      {copy.ctaSecondary}
    </a>
  </div>

  <main class="shell section conversation-shell">
    <header class="conversation-head">
      <p class="conversation-eyebrow">{copy.eyebrow}</p>
      <h1 class="conversation-title">{copy.title}</h1>
      <p class="conversation-intro">{copy.description}</p>
    </header>

    <section class="conversation-body" aria-label="Conversa">
      <div class="conversation-copy">
        {copy.act1.map((block) =>
          block.type === 'ul' ? (
            <ul class="conversation-list">
              {block.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          ) : (
            <p>{block.text}</p>
          ),
        )}
      </div>

      <div class="conversation-actions">
        <a class="button primary" href="#ato-2">{copy.act1Cta}</a>
      </div>

      {copy.act2.length > 0 && (
        <div class="conversation-act2" id="ato-2">
          <h2 class="conversation-act2-title">{copy.act2Title}</h2>
          <div class="conversation-copy">
            {copy.act2.map((block) =>
              block.type === 'ul' ? (
                <ul class="conversation-list">
                  {block.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              ) : (
                <p>{block.text}</p>
              ),
            )}
          </div>
        </div>
      )}

      <div class="conversation-actions">
        <a class="button primary" href={content.routes.audio.path}>{copy.ctaPrimary}</a>
      </div>
    </section>
  </main>

  <SiteFooter left={content.footer.left} right={content.footer.right} />
</BaseLayout>
