---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteFooter from '../../../../components/SiteFooter.astro';
import SiteNav from '../../../../components/SiteNav.astro';
import { CONTENT, LOCALES, isLocale } from '../../../../i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { lang: locale } }));
}

const localeParam = Astro.params.lang;
if (!isLocale(localeParam)) {
  throw new Error(`Invalid locale: ${localeParam}`);
}

const locale = localeParam;
const content = CONTENT[locale];

const copy =
  locale === 'pt'
    ? {
        eyebrow: 'Synora Audio',
        title: 'Quando foi a última vez que vocês fecharam um mês… sem virar investigação?',
        description:
          'Na teoria, parece simples. Na prática: “eu achei que isso já tinha sido pago”, “manda o link de novo”, “calma… deixa eu achar a mensagem”.',
        act1: [
          { type: 'p', text: 'Na teoria, parece simples.' },
          { type: 'p', text: 'Na prática:' },
          {
		            type: 'ul',
		            items: [
		              '“Tem o comprovante… só não sei onde.”',
		              '“Qual planilha é a última mesmo?”',
		              '“Cada um lembra uma porcentagem.”',
		            ],
		          },
          { type: 'p', text: 'E aí...' },
          { type: 'spacer' },
          { type: 'p', text: 'sem ninguém perceber...' },
          { type: 'spacer' },
          { type: 'p', text: 'o mês muda de assunto.' },
          { type: 'spacer' },
          { type: 'p', text: 'Não é sobre áudio.' },
          { type: 'p', text: 'Não é sobre arte.' },
          { type: 'p', text: 'Nem é sobre dinheiro.' },
          { type: 'spacer' },
          { type: 'p', text: 'É sobre reconstruir uma história.' },
          { type: 'p', text: 'Quem participou.' },
          { type: 'p', text: 'Quem decidiu.' },
          { type: 'p', text: 'O que foi aprovado.' },
          { type: 'p', text: 'O que mudou.' },
          { type: 'p', text: 'O que ficou registrado.' },
          { type: 'p', text: '(…)' },
          { type: 'spacer' },
          {
            type: 'p',
            text: 'E quando cada pessoa lembra uma história diferente… até dividir o dinheiro vira briga.',
          },
	          { type: 'spacer' },
	          { type: 'p', text: 'Talvez o problema nunca tenha sido a planilha.' },
	        ],
        act1Cta: 'Continuar lendo',
        act2Title: 'Se eu te pedisse agora…',
        act2: [
          { type: 'p', text: '“Me mostra o que aconteceu nesse lançamento — do começo ao fim.”' },
	          { type: 'p', text: 'Qual foi o primeiro lugar que veio à tua cabeça?' },
	          { type: 'p', text: 'WhatsApp?' },
	          { type: 'p', text: 'E-mail?' },
	          { type: 'p', text: 'Drive?' },
	          { type: 'p', text: 'E em que momento costuma aparecer:' },
	          { type: 'p', text: '“Pera… isso tá em outro lugar.”' },
          { type: 'p', text: '(…)' },
          { type: 'p', text: 'E no final…' },
          { type: 'p', text: 'o mês fecha.' },
          { type: 'p', text: 'Mas…' },
          { type: 'p', text: 'como ele costuma fechar?' },
          {
            type: 'p',
            text: '(Algumas equipes fecham no silêncio. Outras fecham no cansaço. Outras fecham na discussão. Qual é o teu caso?)',
          },
        ],
        ctaPrimary: 'Entrar na página oficial do Audio',
        ctaSecondary: '← Continuar explorando',
      }
    : locale === 'es'
      ? {
          eyebrow: 'Synora Audio',
          title: '¿Cuándo fue la última vez que cerraron un mes… sin que se convierta en una investigación?',
          description:
            'En teoría parece simple. En la práctica: “pensé que esto ya estaba pagado”, “manda el enlace otra vez”, “espera… déjame buscar el mensaje”.',
          act1: [
            { type: 'p', text: 'En teoría parece simple.' },
            { type: 'p', text: 'En la práctica:' },
            {
	              type: 'ul',
		              items: [
		                '“Tengo el comprobante… pero no sé dónde está.”',
		                '“¿Cuál hoja es la última?”',
		                '“Cada uno recuerda un porcentaje.”',
		              ],
		            },
            { type: 'p', text: 'Y entonces…' },
            { type: 'spacer' },
            { type: 'p', text: 'sin que nadie se dé cuenta…' },
            { type: 'spacer' },
            { type: 'p', text: 'el mes cambia de tema.' },
            { type: 'spacer' },
	            { type: 'p', text: 'No es sobre audio.' },
	            { type: 'p', text: 'No es sobre arte.' },
	            { type: 'p', text: 'Ni siquiera es sobre dinero.' },
            { type: 'spacer' },
            { type: 'p', text: 'Se trata de reconstruir una historia.' },
            { type: 'p', text: 'Quién participó.' },
            { type: 'p', text: 'Quién decidió.' },
	            { type: 'p', text: 'Qué fue aprobado.' },
	            { type: 'p', text: 'Qué cambió.' },
	            { type: 'p', text: 'Qué quedó registrado.' },
            { type: 'p', text: '(…)' },
            { type: 'spacer' },
            {
              type: 'p',
              text: 'Y cuando cada persona recuerda una historia distinta… hasta repartir el dinero se convierte en pelea.',
            },
	            { type: 'spacer' },
	            { type: 'p', text: 'Tal vez el problema nunca fue la planilla.' },
	          ],
          act1Cta: 'Seguir leyendo',
          act2Title: 'Si te lo pidiera ahora…',
          act2: [
            { type: 'p', text: '“Muéstrame qué pasó en este lanzamiento — de principio a fin.”' },
	            { type: 'p', text: '¿Cuál fue el primer lugar que te vino a la cabeza?' },
	            { type: 'p', text: '¿WhatsApp?' },
	            { type: 'p', text: '¿E-mail?' },
	            { type: 'p', text: '¿Drive?' },
	            { type: 'p', text: '¿Y en qué momento suele aparecer:' },
	            { type: 'p', text: '“Espera… eso está en otro lugar.”' },
            { type: 'p', text: '(…)' },
            { type: 'p', text: 'Y al final…' },
            { type: 'p', text: 'el mes cierra.' },
            { type: 'p', text: 'Pero…' },
            { type: 'p', text: '¿cómo suele cerrar?' },
            {
              type: 'p',
              text: '(Algunos equipos cierran en silencio. Otros cierran con cansancio. Otros cierran discutiendo. ¿Cuál es tu caso?)',
            },
          ],
          ctaPrimary: 'Ir a la página oficial de Audio',
          ctaSecondary: '← Seguir explorando',
        }
      : {
          eyebrow: 'Synora Audio',
          title: 'When was the last time you closed a month… without turning it into an investigation?',
          description:
            'In theory, it sounds simple. In practice: “I thought this was already paid”, “send the link again”, “wait… let me find the message”.',
          act1: [
            { type: 'p', text: 'In theory, it sounds simple.' },
            { type: 'p', text: 'In practice:' },
            {
	              type: 'ul',
		              items: [
		                '“I have the receipt… I just don’t know where it is.”',
		                '“Which spreadsheet is the latest one?”',
		                '“Everyone remembers a percentage.”',
		              ],
		            },
            { type: 'p', text: 'And then…' },
            { type: 'spacer' },
            { type: 'p', text: 'without anyone noticing…' },
            { type: 'spacer' },
            { type: 'p', text: 'the month changes the subject.' },
            { type: 'spacer' },
            { type: 'p', text: 'It’s not about audio.' },
            { type: 'p', text: 'It’s not about art.' },
            { type: 'p', text: 'It’s not even about money.' },
            { type: 'spacer' },
            { type: 'p', text: 'It’s about rebuilding a story.' },
            { type: 'p', text: 'Who took part.' },
            { type: 'p', text: 'Who decided.' },
            { type: 'p', text: 'What got approved.' },
            { type: 'p', text: 'What changed.' },
            { type: 'p', text: 'What was recorded.' },
            { type: 'p', text: '(…)' },
            { type: 'spacer' },
            {
              type: 'p',
              text: 'And when each person remembers a different story… even splitting the money turns into a fight.',
            },
	            { type: 'spacer' },
	            { type: 'p', text: 'Maybe the problem was never the spreadsheet.' },
	          ],
          act1Cta: 'Keep reading',
          act2Title: 'If I asked you now…',
          act2: [
            { type: 'p', text: '“Show me what happened in this launch — from start to finish.”' },
	            { type: 'p', text: 'What was the first place that came to your mind?' },
	            { type: 'p', text: 'WhatsApp?' },
	            { type: 'p', text: 'Email?' },
	            { type: 'p', text: 'Drive?' },
	            { type: 'p', text: 'And at what point does this usually show up:' },
            { type: 'p', text: '“Wait… that’s somewhere else.”' },
            { type: 'p', text: '(…)' },
            { type: 'p', text: 'And in the end…' },
            { type: 'p', text: 'the month closes.' },
            { type: 'p', text: 'But…' },
            { type: 'p', text: 'how does it usually close?' },
            {
              type: 'p',
              text: '(Some teams close in silence. Some close in exhaustion. Some close in an argument. Which one is yours?)',
            },
          ],
          ctaPrimary: 'Go to the official Audio page',
          ctaSecondary: '← Keep exploring',
        };

const pageTitle = `${copy.eyebrow} — ${locale === 'pt' ? 'Conversa' : locale === 'es' ? 'Conversación' : 'Conversation'}`;
const pageDescription = copy.description;
const path = `${content.routes.audio.path}/conversa`;

const alternates = [
  { hreflang: 'pt-BR', href: `/pt/audio/conversa` },
  { hreflang: 'es', href: `/es/audio/conversa` },
  { hreflang: 'en', href: `/en/audio/conversa` },
  { hreflang: 'x-default', href: '/' },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  path={path}
  lang={content.lang}
  alternates={alternates}
>
  <SiteNav locale={locale} routeKey="audio" variant="quiet" />

  <div class="shell explore-shell">
    <a class="explore-back" href={`${content.routes.home.path}#solucoes`}>
      {copy.ctaSecondary}
    </a>
  </div>

  <main class="shell section conversation-shell">
    <header class="conversation-head">
      <h1 class="conversation-title">{copy.title}</h1>
      <p class="conversation-intro">{copy.description}</p>
    </header>

    <section class="conversation-body" aria-label="Conversa">
      <div class="conversation-copy">
        {copy.act1.map((block) =>
          block.type === 'ul' ? (
            <ul class="conversation-list">
              {block.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          ) : block.type === 'spacer' ? (
            <div class="conversation-spacer" aria-hidden="true" />
          ) : (
            <p>{block.text}</p>
          ),
        )}
      </div>

      <div class="conversation-actions">
        <a class="button primary" href="#ato-2">{copy.act1Cta}</a>
      </div>

      {copy.act2.length > 0 && (
        <div class="conversation-act2" id="ato-2">
          <h2 class="conversation-act2-title">{copy.act2Title}</h2>
          <div class="conversation-copy">
            {copy.act2.map((block) =>
              block.type === 'ul' ? (
                <ul class="conversation-list">
                  {block.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              ) : block.type === 'spacer' ? (
                <div class="conversation-spacer" aria-hidden="true" />
              ) : (
                <p>{block.text}</p>
              ),
            )}
          </div>
        </div>
      )}

      <div class="conversation-actions">
        <a class="button primary" href={content.routes.audio.path}>{copy.ctaPrimary}</a>
        <p class="conversation-whisper">Experimento 001 · {copy.eyebrow}</p>
      </div>
    </section>
  </main>

  <SiteFooter left={content.footer.left} right={content.footer.right} />
</BaseLayout>
