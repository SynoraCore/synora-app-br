---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SiteNav from '../../../components/SiteNav.astro';
import { CONTENT, LOCALES, isLocale, getAlternates } from '../../../i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { lang: locale } }));
}

const localeParam = Astro.params.lang;
if (!isLocale(localeParam)) {
  throw new Error(`Invalid locale: ${localeParam}`);
}

const locale = localeParam;
const content = CONTENT[locale];
const page = content.pages.core;
const routeKey = 'core';
---

<BaseLayout
  title={page.meta.title}
  description={page.meta.description}
  path={page.meta.canonicalPath}
  lang={content.lang}
  alternates={getAlternates(routeKey)}
>
  <SiteNav locale={locale} routeKey={routeKey} />

  <main>
    <section id="visao" class="hero shell core-hero core-editorial-hero">
      <div class="hero-copy">
        <p class="eyebrow">{page.eyebrow}</p>
        <h1>{page.heroTitle}</h1>
        <p class="lead">{page.heroLead}</p>
        <div class="hero-actions">
          <a class="button primary" href="#areas">{page.primaryCta}</a>
          <a class="button" href={content.routes.home.path}>{page.secondaryCta}</a>
        </div>
      </div>

      <div class="core-command-panel core-command-panel-rich" aria-label="Synora Core institutional panel">
        <div class="command-panel-head">
          <span>{page.panel.title}</span>
          <strong>{page.panel.subtitle}</strong>
          <small>{page.panel.caption}</small>
        </div>
        <div class="command-layers">
          {page.panel.layers.map((layer) => (
            <div>
              <span>{layer.index}</span>
              <strong>{layer.label}</strong>
              <small>{layer.note}</small>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="status" class="section shell core-section-tight">
      <div class="core-topbar" aria-label="Core status summary">
        {page.statusCards.map(([label, value, detail]) => (
          <article class="card status-card">
            <p class="tag">{label}</p>
            <strong>{value}</strong>
            <span>{detail}</span>
          </article>
        ))}
      </div>
    </section>

    <section class="section shell core-section-tight">
      <div class="core-principle-band">
        <p class="section-kicker">{page.principle.kicker}</p>
        <h2>{page.principle.title}</h2>
        <p>{page.principle.body}</p>
      </div>
    </section>

    <section class="section shell core-section-tight">
      <div class="core-structure-panel">
        <div class="section-head">
          <p class="section-kicker">{page.commandCenter.kicker}</p>
          <h2>{page.commandCenter.title}</h2>
          <p class="section-copy">{page.commandCenter.copy}</p>
        </div>
        <div class="core-pillar-list">
          {page.commandCenter.pillars.map(([name, desc]) => (
            <article>
              <strong>{name}</strong>
              <p>{desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="areas" class="section shell core-section-tight">
      <div class="section-head">
        <p class="section-kicker">{page.areas.kicker}</p>
        <h2>{page.areas.title}</h2>
        <p class="section-copy">{page.areas.copy}</p>
      </div>

      <div class="grid-2">
        {page.areas.cards.map((area) => (
          <article class="card quiet-card core-area-card">
            <div class="card-top">
              <h3>{area.name}</h3>
              <span class="tag">{page.areas.tag}</span>
            </div>
            <p>{area.desc}</p>
            <div class="meta">{area.meta}</div>
          </article>
        ))}
      </div>
    </section>

    <section id="principio" class="section shell">
      <div class="split core-trail-layout">
        <div class="section-head">
          <p class="section-kicker">{page.trail.kicker}</p>
          <h2>{page.trail.title}</h2>
          <p class="section-copy">{page.trail.copy}</p>
        </div>
        <div class="panel core-trail">
          {page.trail.steps.map(([label, text], index) => (
            <div class="trail-item">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <strong>{label}</strong>
                <p>{text}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <SiteFooter left={page.footerLeft} right={page.footerRight} />
</BaseLayout>

