---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteNav from '../../components/SiteNav.astro';
import ConstellationOrbit from '../../components/ConstellationOrbit.astro';
import { CONTENT, LOCALES, isLocale, getAlternates } from '../../i18n';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { lang: locale } }));
}

const localeParam = Astro.params.lang;
if (!isLocale(localeParam)) {
  throw new Error(`Invalid locale: ${localeParam}`);
}

const locale = localeParam;
const content = CONTENT[locale];
const page = content.pages.home;
const routeKey = 'home';
---

<BaseLayout
  title={page.meta.title}
  description={page.meta.description}
  path={page.meta.canonicalPath}
  lang={content.lang}
  alternates={getAlternates(routeKey)}
>
  <SiteNav locale={locale} routeKey={routeKey} variant="home" />

  <main>
    <section class="hero shell">
      <div class="hero-copy">
        <p class="eyebrow">{page.hero.eyebrow}</p>
        <h1>{page.hero.title}</h1>
        <p class="lead">{page.hero.lead}</p>
        <div class="hero-actions">
          <a class="button primary" href="#infraestrutura">{page.hero.primaryCta}</a>
          <a class="button" href={content.routes.core.path}>{page.hero.secondaryCta}</a>
        </div>
      </div>
      <div class="hero-system" aria-label="Synora ecosystem layers">
        <ConstellationOrbit coreLabel="Core" items={page.hero.systemPills.map((label) => ({ label }))} />
      </div>
    </section>

    <section id="infraestrutura" class="section shell">
      <div class="section-head">
        <p class="section-kicker">{page.infrastructure.kicker}</p>
        <h2>{page.infrastructure.title}</h2>
        <p class="section-copy">{page.infrastructure.copy}</p>
      </div>

      <div class="grid-3">
        {page.infrastructure.cards.map((item) => (
          <article class="card">
            <div class="card-top">
              <h3>{item.name}</h3>
              <span class="tag">{page.infrastructure.tag}</span>
            </div>
            <p>{item.desc}</p>
            <div class="meta">{item.meta}</div>
            {item.actionLabel && item.actionHref && (
              <div class="card-actions">
                <a class="button primary" href={item.actionHref}>{item.actionLabel}</a>
              </div>
            )}
          </article>
        ))}
      </div>
    </section>

    <section id="solucoes" class="section shell">
      <div class="section-head">
        <p class="section-kicker">{page.solutions.kicker}</p>
        <h2>{page.solutions.title}</h2>
        <p class="section-copy">{page.solutions.copy}</p>
      </div>

      <div class="grid-2">
        {page.solutions.cards.map((item) => (
          <article class="card">
            <div class="card-top">
              <h3>{item.name}</h3>
              <span class="tag">{page.solutions.tag}</span>
            </div>
            <p>{item.desc}</p>
            <div class="meta">{item.meta}</div>
          </article>
        ))}
      </div>
    </section>

    <section id="sobre" class="section shell">
      <div class="split">
        <div class="section-head">
          <p class="section-kicker">{page.about.kicker}</p>
          <h2>{page.about.title}</h2>
        </div>
        <div class="panel">
          <p>{page.about.body}</p>
        </div>
      </div>
    </section>

    <section id="contato" class="section shell">
      <div class="panel contact-panel">
        <div>
          <p class="section-kicker">{page.contact.kicker}</p>
          <h2>{page.contact.title}</h2>
          <p class="section-copy">{page.contact.copy}</p>
        </div>
        <div class="contact-action">
          <a class="button primary" href={`mailto:${page.contact.email}`}>{page.contact.ctaLabel}</a>
          <span class="contact-email">{page.contact.email}</span>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter left={content.footer.left} right={content.footer.right} />
</BaseLayout>
