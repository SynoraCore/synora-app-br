---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAlternates } from '../i18n';

const routeKey = 'home';
---

<BaseLayout title="Synora" description="International entrypoint" path="/" alternates={getAlternates(routeKey)}>
  <main class="shell" style="padding: 120px 0;">
    <p class="eyebrow">Synora</p>
    <h1>Redirecting…</h1>
    <p class="lead">Selecting the best language for your browser.</p>
    <div class="hero-actions">
      <a class="button" href="/pt">Português</a>
      <a class="button" href="/es">Español</a>
      <a class="button" href="/en">English</a>
    </div>
  </main>

  <script is:inline>
    (function () {
      const KEY = 'synora_lang';
      const supported = ['pt', 'es', 'en'];

      function normalize(value) {
        if (!value) return null;
        const lower = String(value).toLowerCase();
        if (lower.startsWith('pt')) return 'pt';
        if (lower.startsWith('es')) return 'es';
        return 'en';
      }

      const stored = normalize(window.localStorage.getItem(KEY));
      const browser = normalize(navigator.language || (navigator.languages && navigator.languages[0]));
      const chosen = supported.includes(stored) ? stored : supported.includes(browser) ? browser : 'en';

      try {
        window.localStorage.setItem(KEY, chosen);
      } catch {}

      window.location.replace('/' + chosen);
    })();
  </script>
</BaseLayout>
