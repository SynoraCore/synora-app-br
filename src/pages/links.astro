---
import LinksLayout from '../layouts/LinksLayout.astro';
import LinksCard from '../components/LinksCard.astro';
import SynoraHaloSignature from '../components/SynoraHaloSignature.astro';
import { getLinksPage } from '../modules/links/pages';

const page = getLinksPage('links');
const year = new Date().getFullYear();
---

<LinksLayout title={page.title} description={page.description} path="/links" ogImage="/brand-primary-512.png">
  <main class="wrap">
    <header class="brand">
      <SynoraHaloSignature />
      <h1>{page.headline}</h1>
      <p class="tagline">{page.tagline}</p>
      <p class="intro">Official access to Synora&#39;s ecosystem.</p>
      <div class="rule" aria-hidden="true"></div>
    </header>

    <section class="list" aria-label="Official links">
      {page.items.map((item) => (
        <LinksCard {...item} />
      ))}
    </section>

    <footer class="foot">
      <div>© {year} Synora</div>
      <div>Official Institutional Links</div>
    </footer>
  </main>
</LinksLayout>
