---
import LinksLayout from '../layouts/LinksLayout.astro';
import LinksCard from '../components/LinksCard.astro';
import { getLinksPage } from '../modules/links/pages';

const page = getLinksPage('links');
---

<LinksLayout title={page.title} description={page.description} path="/links" ogImage="/brand-primary-512.png">
  <main class="wrap">
    <header class="brand">
      <div class="logo" aria-hidden="true">
        <img src="/brand/synora-mark.svg" alt="" width="28" height="28" loading="eager" decoding="async" />
      </div>
      <h1>{page.headline}</h1>
      <p class="tagline">{page.tagline}</p>
    </header>

    <section class="list" aria-label="Official links">
      {page.items.map((item) => (
        <LinksCard {...item} />
      ))}
    </section>

    <footer class="foot">Synora Links is an institutional page, not a product.</footer>
  </main>
</LinksLayout>

