---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SiteNav from '../../../components/SiteNav.astro';
import { CONTENT, getAlternates } from '../../../i18n';

const content = CONTENT.pt;
const routeKey = 'home';
const title = 'Biblioteca — Synora';
const description = 'Biblioteca institucional em preparação.';
const path = '/pt/biblioteca/';
---

<BaseLayout title={title} description={description} path={path} lang={content.lang} alternates={getAlternates(routeKey)}>
  <SiteNav locale="pt" routeKey={routeKey} />
  <main>
    <section class="biblioteca-stub" aria-label="Biblioteca">
      <div class="biblioteca-shell">
        <p class="biblioteca-eyebrow">Biblioteca</p>
        <h1 class="biblioteca-title">Biblioteca</h1>
        <p class="biblioteca-dek">Em preparação.</p>
        <div class="biblioteca-actions">
          <a class="button secondary" href={content.routes.home.path}>Voltar para Home</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter left={content.footer.left} right={content.footer.right} />
</BaseLayout>

<style>
  .biblioteca-stub {
    background: rgba(245, 247, 251, 1);
    color: rgba(7, 24, 39, 1);
    padding: calc(70px + 64px) 0 96px;
  }

  .biblioteca-shell {
    width: min(var(--max), calc(100% - (var(--side-pad) * 2)));
    margin-inline: auto;
    max-width: 900px;
  }

  .biblioteca-eyebrow {
    margin: 0 0 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 700;
    color: rgba(7, 24, 39, 0.62);
  }

  .biblioteca-title {
    margin: 0;
    font-size: clamp(42px, 4.6vw, 64px);
    font-weight: 800;
    line-height: 1.02;
  }

  .biblioteca-dek {
    margin: 18px 0 0;
    color: rgba(7, 24, 39, 0.72);
    font-size: 18px;
    line-height: 1.6;
    max-width: 760px;
  }

  .biblioteca-actions {
    margin-top: 22px;
  }

  @media (max-width: 980px) {
    .biblioteca-stub {
      padding: calc(60px + 56px) 0 80px;
    }

    .biblioteca-title {
      font-size: clamp(38px, 7vw, 54px);
    }
  }
</style>
