---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SiteNav from '../../../components/SiteNav.astro';
import { CONTENT, getAlternates } from '../../../i18n';

const content = CONTENT.pt;
const routeKey = 'home';
const title = 'Biblioteca — Synora';
const description = 'Biblioteca do PACK-001 — IA no Trabalho.';
const path = '/pt/biblioteca/';

const pack = 'PACK-001 — IA no Trabalho';

const units = [
  {
    code: 'PR-002',
    name: 'Melhore seu Pedido',
    slug: 'pr-002',
    cover: '/biblioteca/pack-001/pr-002.png',
    description: 'Estruture pedidos confusos em instruções claras.',
  },
  {
    code: 'PR-003',
    name: 'Contexto Certo',
    slug: 'pr-003',
    cover: '/biblioteca/pack-001/pr-003.png',
    description: 'Extraia só o contexto que muda o resultado.',
  },
  {
    code: 'PR-004',
    name: 'Planeje o Resultado',
    slug: 'pr-004',
    cover: '/biblioteca/pack-001/pr-004.png',
    description: 'Defina a saída antes de produzir a saída.',
  },
  {
    code: 'PR-005',
    name: 'Crie a Primeira Versão',
    slug: 'pr-005',
    cover: '/biblioteca/pack-001/pr-005.png',
    description: 'Execute 80/20 e chegue na primeira versão utilizável.',
  },
  {
    code: 'PR-006',
    name: 'Melhore seu Conteúdo',
    slug: 'pr-006',
    cover: '/biblioteca/pack-001/pr-006.png',
    description: 'Refino por critérios, sem reescrita arbitrária.',
  },
  {
    code: 'PR-007',
    name: 'Separe Fatos de Suposições',
    slug: 'pr-007',
    cover: '/biblioteca/pack-001/pr-007.png',
    description: 'Não trate inferência como fato.',
  },
  {
    code: 'PR-008',
    name: 'Verifique antes de Usar',
    slug: 'pr-008',
    cover: '/biblioteca/pack-001/pr-008.png',
    description: 'Resposta convincente não é necessariamente confiável.',
  },
  {
    code: 'PR-009',
    name: 'Adapte para seu Público',
    slug: 'pr-009',
    cover: '/biblioteca/pack-001/pr-009.png',
    description: 'Mude a forma sem distorcer o conteúdo.',
  },
];

const commerceReady = false;
---

<BaseLayout title={title} description={description} path={path} lang={content.lang} alternates={getAlternates(routeKey)}>
  <SiteNav locale="pt" routeKey={routeKey} />
  <main>
    <section class="biblioteca" aria-label="Biblioteca">
      <div class="biblioteca-shell">
        <header class="biblioteca-head">
          <p class="biblioteca-eyebrow">Biblioteca</p>
          <h1 class="biblioteca-title">PACK-001</h1>
          <p class="biblioteca-dek">IA no Trabalho</p>
        </header>

        <div class="biblioteca-grid" role="list">
          {units.map((unit) => (
            <article class="unit" role="listitem">
              <div class="unit-cover">
                <img src={unit.cover} alt={`Capa ${unit.code} — ${unit.name}`} loading="lazy" decoding="async" />
              </div>
              <div class="unit-body">
                <div class="unit-meta">
                  <span class="unit-code">{unit.code}</span>
                  <span class="unit-pack">{pack}</span>
                </div>
                <h2 class="unit-title">{unit.name}</h2>
                <p class="unit-desc">{unit.description}</p>
                <div class="unit-actions">
                  <button class="unit-button" disabled={!commerceReady} aria-disabled={!commerceReady}>
                    {commerceReady ? 'Acessar' : 'Em breve'}
                  </button>
                </div>
              </div>
            </article>
          ))}
        </div>

        {!commerceReady && (
          <p class="biblioteca-note">
            Compra e acesso ainda estão desativados enquanto o fluxo comercial não estiver pronto.
          </p>
        )}
      </div>
    </section>
  </main>
  <SiteFooter left={content.footer.left} right={content.footer.right} />
</BaseLayout>

<style>
  .biblioteca {
    background: rgba(245, 247, 251, 1);
    color: rgba(7, 24, 39, 1);
    padding: calc(70px + 64px) 0 96px;
  }

  .biblioteca-shell {
    width: min(var(--max), calc(100% - (var(--side-pad) * 2)));
    margin-inline: auto;
    max-width: 1100px;
  }

  .biblioteca-head {
    max-width: 900px;
  }

  .biblioteca-eyebrow {
    margin: 0 0 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 700;
    color: rgba(7, 24, 39, 0.62);
  }

  .biblioteca-title {
    margin: 0;
    font-size: clamp(42px, 4.6vw, 64px);
    font-weight: 800;
    line-height: 1.02;
  }

  .biblioteca-dek {
    margin: 14px 0 0;
    color: rgba(7, 24, 39, 0.72);
    font-size: 18px;
    line-height: 1.6;
    max-width: 760px;
  }

  .biblioteca-grid {
    margin-top: 34px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 22px;
    align-items: stretch;
  }

  .unit {
    border-radius: 18px;
    overflow: hidden;
    background: rgba(255, 255, 255, 1);
    border: 1px solid rgba(7, 24, 39, 0.10);
    box-shadow: 0 10px 30px rgba(7, 24, 39, 0.06);
    display: flex;
    flex-direction: column;
  }

  .unit-cover {
    background: rgba(250, 251, 254, 1);
  }

  .unit-cover img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 620 / 877;
    object-fit: cover;
  }

  .unit-body {
    padding: 16px 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
    min-width: 0;
  }

  .unit-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    align-items: center;
  }

  .unit-code {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 800;
    color: rgba(7, 24, 39, 0.72);
  }

  .unit-pack {
    font-size: 12px;
    color: rgba(7, 24, 39, 0.52);
  }

  .unit-title {
    margin: 0;
    font-size: 18px;
    line-height: 1.15;
    letter-spacing: -0.01em;
    min-width: 0;
  }

  .unit-desc {
    margin: 0;
    color: rgba(7, 24, 39, 0.66);
    line-height: 1.55;
    font-size: 14px;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    white-space: normal;
    overflow-wrap: break-word;
    word-break: break-word;
    hyphens: auto;
  }

  .unit-actions {
    margin-top: auto;
    padding-top: 6px;
  }

  .unit-button {
    width: 100%;
    border: 0;
    border-radius: 12px;
    padding: 12px 14px;
    font-weight: 800;
    font-size: 14px;
    letter-spacing: 0.02em;
    background: rgba(7, 24, 39, 0.08);
    color: rgba(7, 24, 39, 0.55);
    cursor: not-allowed;
  }

  .biblioteca-note {
    margin: 20px 0 0;
    max-width: 900px;
    color: rgba(7, 24, 39, 0.55);
    font-size: 13px;
    line-height: 1.55;
  }

  @media (max-width: 980px) {
    .biblioteca {
      padding: calc(60px + 56px) 0 80px;
    }

    .biblioteca-title {
      font-size: clamp(38px, 7vw, 54px);
    }

    .biblioteca-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }

  @media (max-width: 640px) {
    .biblioteca-grid {
      grid-template-columns: 1fr;
    }

    .unit-body {
      padding: 14px 14px 16px;
    }
  }
</style>
