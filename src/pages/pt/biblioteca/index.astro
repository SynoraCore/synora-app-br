---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SiteNav from '../../../components/SiteNav.astro';
import { CONTENT, getAlternates } from '../../../i18n';

const content = CONTENT.pt;
const routeKey = 'home';
const title = 'Biblioteca — Synora';
const description = 'Coleções institucionais em preparação.';
const path = '/pt/biblioteca/';
---

<BaseLayout title={title} description={description} path={path} lang={content.lang} alternates={getAlternates(routeKey)}>
  <SiteNav locale="pt" routeKey={routeKey} />
  <main>
    <section class="lib-surface" aria-label="Biblioteca">
      <div class="lib-shell">
        <header class="lib-head">
          <p class="lib-eyebrow">Biblioteca</p>
          <h1 class="lib-title">Biblioteca</h1>
          <p class="lib-dek">Referências e coleções em preparação.</p>
        </header>

        <section class="lib-section" aria-label="Coleções">
          <h2 class="lib-section-title">Coleções</h2>
          <div class="lib-grid">
            <article class="lib-card" aria-label="PACK-001 — IA no Trabalho">
              <div class="lib-card-body">
                <p class="lib-kicker">PACK-001</p>
                <h3 class="lib-card-title">IA no Trabalho</h3>
                <p class="lib-card-desc">Coleção de Prompt Units para uso prático no dia a dia.</p>
                <p class="lib-status" aria-label="Status">Em preparação</p>
              </div>
            </article>
          </div>
        </section>

        <section class="lib-section" aria-label="Itens">
          <h2 class="lib-section-title">Itens</h2>
          <div class="lib-grid">
            <article class="lib-card lib-card--item" aria-label="PR-002 — Melhore seu Pedido">
              <div class="lib-thumb" aria-hidden="true">
                <img
                  src="/protocolos/PACK-001/PR-002/PR-002.cover.thumb.620x877.png"
                  alt=""
                  loading="eager"
                  decoding="async"
                />
              </div>
              <div class="lib-card-body">
                <p class="lib-kicker">PR-002</p>
                <h3 class="lib-card-title">Melhore seu Pedido</h3>
                <p class="lib-card-desc">Transforme uma ideia confusa em um pedido claro para a IA.</p>
                <p class="lib-status" aria-label="Status">Capa aprovada · FROZEN (referência visual)</p>
              </div>
            </article>
          </div>
        </section>

        <div class="lib-actions">
          <a class="button secondary" href={content.routes.home.path}>Voltar para Home</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter left={content.footer.left} right={content.footer.right} />
</BaseLayout>

<style>
  .lib-surface {
    background: rgba(245, 247, 251, 1);
    color: rgba(7, 24, 39, 1);
    padding: calc(70px + 64px) 0 96px;
  }

  .lib-shell {
    width: min(var(--max), calc(100% - (var(--side-pad) * 2)));
    margin-inline: auto;
  }

  .lib-head {
    max-width: 900px;
    margin: 0 auto 42px;
  }

  .lib-eyebrow {
    margin: 0 0 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-size: 12px;
    font-weight: 700;
    color: rgba(7, 24, 39, 0.62);
  }

  .lib-title {
    margin: 0;
    font-size: clamp(42px, 4.6vw, 64px);
    font-weight: 800;
    line-height: 1.02;
  }

  .lib-dek {
    margin: 18px 0 0;
    color: rgba(7, 24, 39, 0.72);
    font-size: 18px;
    line-height: 1.6;
    max-width: 760px;
  }

  .lib-section {
    max-width: 900px;
    margin: 0 auto 42px;
  }

  .lib-section-title {
    margin: 0 0 14px;
    font-size: 14px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 780;
    color: rgba(7, 24, 39, 0.76);
  }

  .lib-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .lib-card {
    background: rgba(251, 252, 254, 1);
    border: 1px solid rgba(7, 24, 39, 0.08);
    border-radius: 22px;
    overflow: hidden;
    box-shadow:
      0 22px 50px rgba(7, 24, 39, 0.08),
      0 1px 0 rgba(255, 255, 255, 0.8) inset;
  }

  .lib-card--item {
    display: grid;
    grid-template-columns: 220px 1fr;
  }

  .lib-thumb {
    background: rgba(7, 24, 39, 0.04);
    border-right: 1px solid rgba(7, 24, 39, 0.06);
    display: grid;
    place-items: center;
    padding: 18px;
  }

  .lib-thumb img {
    width: 100%;
    height: auto;
    border-radius: 16px;
    box-shadow: 0 18px 44px rgba(7, 24, 39, 0.16);
  }

  .lib-card-body {
    padding: 18px 18px 16px;
  }

  .lib-kicker {
    margin: 0 0 10px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(7, 24, 39, 0.6);
  }

  .lib-card-title {
    margin: 0;
    font-size: 22px;
    line-height: 1.12;
    font-weight: 820;
    color: rgba(7, 24, 39, 0.92);
  }

  .lib-card-desc {
    margin: 10px 0 0;
    font-size: 15px;
    line-height: 1.6;
    color: rgba(7, 24, 39, 0.72);
    max-width: 48ch;
  }

  .lib-status {
    margin: 14px 0 0;
    font-size: 13px;
    line-height: 1.4;
    font-weight: 650;
    color: rgba(7, 24, 39, 0.68);
  }

  .lib-actions {
    max-width: 900px;
    margin: 8px auto 0;
    display: flex;
    justify-content: flex-start;
  }

  @media (max-width: 900px) {
    .lib-grid {
      grid-template-columns: 1fr;
    }

    .lib-card--item {
      grid-template-columns: 1fr;
    }

    .lib-thumb {
      border-right: 0;
      border-bottom: 1px solid rgba(7, 24, 39, 0.06);
    }
  }
</style>
