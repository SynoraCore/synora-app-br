---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('publicacoes');
  const published = entries.filter((entry) => entry.data.edition === 'pt-BR' && entry.data.status === 'published');

  return published.map((entry) => ({
    params: { slug: entry.data.slug },
  }));
}

const { slug } = Astro.params;
return Astro.redirect(`https://publicacoes.synora.app.br/pt/publicacoes/${slug}/`, 308);
---
